# Variables used by docker-compose.yml. Every one of them has a default,
# so this file is optional: `cp .env.example .env` and adjust as needed.

# --- Images -----------------------------------------------------------------
# Docker Hub namespace (your username) and tag. Use them to run the published
# images: `docker compose pull && docker compose up -d`
DOCKERHUB_NAMESPACE=library-local
IMAGE_TAG=latest

# --- Laravel ----------------------------------------------------------------
# Generate one with: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# If empty, the container generates an ephemeral key on start-up.
APP_KEY=
APP_ENV=production
APP_DEBUG=false
RUN_MIGRATIONS=true
RUN_SEEDERS=true
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173
# API rate limiting per client IP (requests per minute)
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_WRITES_PER_MINUTE=20

# --- Database (PostgreSQL) --------------------------------------------------
DB_DATABASE=library
DB_USERNAME=postgres
DB_PASSWORD=postgres_secret

# --- Published ports --------------------------------------------------------
FRONTEND_PORT=8081
BACKEND_PORT=8010
DB_FORWARD_PORT=5433
