# Base URL used by the SPA to call the API.
# "/api" is proxied to Laravel by Vite (pnpm dev) and by Nginx (Docker).
VITE_API_URL=/api

# Only for `pnpm dev`: where the Vite proxy forwards /api/*
VITE_DEV_API_PROXY_TARGET=http://localhost:8000

# Frontend version shown in the footer. The Docker build sets it from APP_VERSION.
VITE_APP_VERSION=dev
